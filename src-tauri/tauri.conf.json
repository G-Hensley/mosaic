{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic",
  "version": "0.1.0",
  "identifier": "com.gavinhensley.mosaic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mosaic",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Gavin Hensley",
    "shortDescription": "Multi-agent cockpit",
    "longDescription": "Run parallel AI coding sessions side by side, each in its own terminal and optionally its own git worktree, connected by a shared MCP brain.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
